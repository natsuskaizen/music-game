{
  "name": "music-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run dupes && npm run knip && npm test && npm run build && npm run size",
    "test": "vitest run --coverage",
    "e2e": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "dupes": "jscpd",
    "knip": "knip",
    "ac-report": "node scripts/ac-report/main.ts",
    "size": "node scripts/size-budget/main.ts",
    "icons": "node scripts/icons/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "jscpd": "^5.4.2",
    "knip": "^6.44.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  }
}
